# ==============================
# Environment Configuration
# Copy this file to .env and fill in values
# ==============================

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Logging
# LOG_DIR is resolved to an absolute path at startup (independent of CWD); the
# file sink rotates daily and keeps 7 days. LOG_LEVEL sets the console level
# (the file always keeps DEBUG). DEBUG=true also makes 500 responses echo the
# raw error string.
LOG_DIR=./logs
LOG_LEVEL=INFO

# File Storage
UPLOAD_DIR=./uploads
RESULTS_DIR=./results

# Detection Model
# Options: "florence2", "grounding_dino", "yoloe"
DETECTION_MODEL=yoloe

# GPU Device (e.g. "cuda:0", "cuda:1", "cpu")
DEVICE=cuda:0

# Florence-2 model variant (if using Florence-2)
FLORENCE2_MODEL_ID=microsoft/Florence-2-large

# Grounding DINO config and checkpoint (if using Grounding DINO)
GDINO_CONFIG_PATH=./models/groundingdino/config/GroundingDINO_SwinT_OGC.py
GDINO_CHECKPOINT_PATH=./models/groundingdino/weights/groundingdino_swint_ogc.pth

# YOLOE base weights — open-vocabulary detection ONLY (default video detector +
# zero-shot image detection via set_classes).
# Model options: yoloe-11l-seg.pt (large), yoloe-11m-seg.pt (medium), yoloe-11s-seg.pt (small)
YOLOE_BASE_MODEL=yoloe-11l-seg.pt

# Custom-training base weights — a PLAIN Ultralytics YOLOv11 detection model
# (loaded via YOLO, standard DetectionTrainer). Decoupled from YOLOE_BASE_MODEL.
# Options: yolo11l.pt (large), yolo11m.pt (medium), yolo11s.pt (small). Absolute
# path recommended (offline training needs the file present locally).
TRAIN_BASE_MODEL=yolo11l.pt

# Custom-training defaults (tuned for SMALL objects; all overridable per request).
# imgsz 1280: tiny objects are unlearnable at 640 (~9px). It is also the memory
#   lever — the per-epoch validation pass at 1280 peaks ~15.9GB on a 16GB GPU
#   shared with the warm YOLOE detector (~0.4GB free). A solo run is fine; if you
#   need to run detection DURING training, drop this to 1024 (~6GB free).
# batch 3: only affects the ~10GB training phase (val peak is batch-independent);
#   Ultralytics grad-accumulates to nbs=64, so small batch trains fine.
# mosaic/scale low + close_mosaic: mosaic & scale jitter shrink tiny objects;
#   keep them light and finish the last epochs on clean targets.
TRAIN_DEFAULT_IMGSZ=1280
TRAIN_DEFAULT_BATCH=3
TRAIN_MOSAIC=0.3
TRAIN_SCALE=0.2
TRAIN_CLOSE_MOSAIC=15
# SAHI slicing parameters for small object detection
SAHI_SLICE_HEIGHT=640
SAHI_SLICE_WIDTH=640
SAHI_OVERLAP_HEIGHT_RATIO=0.2
SAHI_OVERLAP_WIDTH_RATIO=0.2

# Detection thresholds
BOX_THRESHOLD=0.35
TEXT_THRESHOLD=0.25

# ByteTrack parameters
# TRACK_THRESH should be aligned with BOX_THRESHOLD; otherwise ByteTrack
# silently filters out low-score detector boxes (typical for small objects).
TRACK_THRESH=0.25
TRACK_BUFFER=30
MATCH_THRESH=0.8

# Frame sampling: run detection every N frames, track in between
DETECTION_INTERVAL=5

# Frame saving and compression
# Options: "all" | "keyframes_only" | "detections_only"
# - keyframes_only: every detection keyframe (incl. those with no boxes)
# - detections_only: only keyframes that actually have ≥1 detection drawn
SAVE_FRAMES_MODE=detections_only
JPEG_QUALITY=85

# Max concurrent tasks (GPU memory constraint)
MAX_CONCURRENT_TASKS=2

# Optional: Redis URL for Celery task queue
# REDIS_URL=redis://localhost:6379/0

# PostgreSQL (task history persistence)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# Create the database first:  createdb -U postgres sod
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sod
DATABASE_ECHO=false

# ── LLM auto-annotation (Qwen via DashScope OpenAI-compatible endpoint) ──────
# Backend-fixed provider (Qwen). Only the API key + model are configurable here.
# Get an API key at https://bailian.console.aliyun.com/ . Leave LLM_API_KEY empty
# to disable the "LLM标注" feature.
LLM_API_KEY=
# Vision model ID — MUST be a multimodal "VL" model that can read images
# (NOT a text-only model like qwen-max). Recommended: qwen3-vl-plus.
LLM_MODEL=qwen3-vl-plus
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MAX_CONCURRENT=3
LLM_IMAGE_MAX_SIZE=1024
LLM_TIMEOUT_SECONDS=120
