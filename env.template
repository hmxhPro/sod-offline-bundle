# ============================================================================
# SOD 后端环境配置模板 (.env)
# ----------------------------------------------------------------------------
# install.sh 会把本文件复制为 backend/.env，并把占位符 __SOD_HOME__ 替换为实际
# 安装目录的绝对路径。DATABASE_URL 由 backend/scripts/init_postgres.sh 自动写入
# （若不启用历史记录数据库，可保持默认值或删除该行——后端仍可正常检测）。
#
# 关键说明：本系统已按“离线模式”配置，以下三个开关确保 ultralytics / HuggingFace
# 不会尝试联网下载任何权重或字体。请勿删除。
# ============================================================================

# ── 离线开关（务必保留）────────────────────────────────────────────────────
HF_DATASETS_OFFLINE=1
YOLO_OFFLINE=1
ULTRALYTICS_OFFLINE=1

# ── 服务 ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── 文件存储（相对 backend/ 工作目录，启动时自动创建）──────────────────────
UPLOAD_DIR=./uploads
RESULTS_DIR=./results
LOG_DIR=./logs
LOG_LEVEL=INFO

# ── 检测模型 ────────────────────────────────────────────────────────────────
# 可选：florence2 | grounding_dino | yoloe（默认 yoloe，开箱即用）
DETECTION_MODEL=yoloe
# GPU 设备；无 GPU 时可设为 cpu（速度极慢，不推荐）
DEVICE=cuda:0

# Florence-2（仅当 DETECTION_MODEL=florence2 时使用，离线需另行准备 HF 权重）
FLORENCE2_MODEL_ID=microsoft/Florence-2-large

# Grounding DINO（仅当 DETECTION_MODEL=grounding_dino 时使用；需另行编译安装
# groundingdino 包，详见部署文档“可选组件”一节）
GDINO_CHECKPOINT_PATH=./models/groundingdino/weights/groundingdino_swint_ogc.pth

# ── 权重绝对路径（install.sh 自动替换 __SOD_HOME__）────────────────────────
# YOLOE 开放词表检测基础权重（默认视频/图像检测器）
YOLOE_BASE_MODEL=__SOD_HOME__/backend/models/yolo/yoloe-11l-seg.pt
# 自定义训练基础权重（标准 YOLOv11 检测模型）
TRAIN_BASE_MODEL=__SOD_HOME__/backend/models/yolo/yolo11l.pt

# ── SAHI 小目标切片推理 ─────────────────────────────────────────────────────
SAHI_SLICE_HEIGHT=640
SAHI_SLICE_WIDTH=640
SAHI_OVERLAP_HEIGHT_RATIO=0.2
SAHI_OVERLAP_WIDTH_RATIO=0.2

# ── 检测阈值 ────────────────────────────────────────────────────────────────
BOX_THRESHOLD=0.35
TEXT_THRESHOLD=0.25

# ── 帧质量过滤 ──────────────────────────────────────────────────────────────
ENABLE_FRAME_QUALITY_CHECK=true
BLACK_FRAME_THRESHOLD=15.0
DARK_FRAME_THRESHOLD=30.0
BRIGHT_FRAME_THRESHOLD=240.0
MIN_FRAME_STD_DEV=10.0

# ── 帧保存策略 ──────────────────────────────────────────────────────────────
# all | keyframes_only | detections_only | unique_targets | best_shot
SAVE_FRAMES_MODE=unique_targets
TRACK_SAVE_COOLDOWN_SEC=10
JPEG_QUALITY=85

# 最佳帧打分权重
BEST_SHOT_WEIGHT_SHARPNESS=0.4
BEST_SHOT_WEIGHT_AREA=0.3
BEST_SHOT_WEIGHT_CONFIDENCE=0.3
BEST_SHOT_SHARPNESS_REF=200.0
BEST_SHOT_AREA_REF=0.05
BEST_SHOT_EDGE_MARGIN_PX=4
BEST_SHOT_EDGE_PENALTY=0.6
BEST_SHOT_MIN_SCORE=0.0

# ── 标注绘制 ────────────────────────────────────────────────────────────────
BOX_THICKNESS=6
CORNER_LENGTH=40

# ── ByteTrack 多目标跟踪 ────────────────────────────────────────────────────
TRACK_THRESH=0.25
TRACK_BUFFER=30
MATCH_THRESH=0.8

# ── 处理 ────────────────────────────────────────────────────────────────────
DETECTION_INTERVAL=5
MAX_CONCURRENT_TASKS=2

# ── 数据库（任务历史持久化，可选）──────────────────────────────────────────
# 由 init_postgres.sh 自动写入正确的用户名/随机密码。
# 不启用数据库时后端仍可检测，仅历史记录功能不可用。
DATABASE_URL=postgresql+asyncpg://sod_app:CHANGE_ME@localhost:5432/sod
DATABASE_ECHO=false

# ── LLM 自动标注（通义千问 Qwen · 数据标注）────────────────────────────────
# 调用大模型自动标注数据集图片。提供商固定为 Qwen，经阿里云 DashScope（百炼）的
# OpenAI 兼容端点访问。只需在此填入 API Key，并按需修改模型型号即可。
#   - 获取 API Key: https://bailian.console.aliyun.com/
#   - 留空则前端「LLM标注」功能提示未配置、无法创建任务。
LLM_API_KEY=
LLM_MODEL=qwen-vl-max-latest
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MAX_CONCURRENT=3
LLM_IMAGE_MAX_SIZE=1024
LLM_TIMEOUT_SECONDS=120
